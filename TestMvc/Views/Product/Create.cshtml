@model Domain.Model.ProductModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display:none;">
                <label asp-for="ProductId" class="control-label"></label>
                <input asp-for="ProductId" class="form-control" />
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SKU" class="control-label"></label>
                <input id="sk1" class="form-control"  readonly />
                <input asp-for="SKU" class="form-control" hidden />
                <button type="button" id="generateSku" class="btn btn-primary mt-2">Generate SKU</button>
                <span asp-validation-for="SKU" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <select class="form-control" id="Category"  asp-for="Category">
                    <option value="">Select Category</option>
                    @foreach (var category in ViewData["CategoryList"] as IEnumerable<Domain.DTO.CategoryDTO>)
                    {
                        <option value="@category.CategoryID">
                            @category.CategoryName
                        </option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>

               
            </div>
            <div class="form-group">
                <label asp-for="BasePrice" class="control-label"></label>
                <input asp-for="BasePrice" class="form-control" />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MRP" class="control-label"></label>
                <input asp-for="MRP" class="form-control" />
                <span asp-validation-for="MRP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" ></textarea>
                
            </div>
            <div class="form-group">
                <label asp-for="Currency" class="control-label"></label>
                               <select class="form-control" asp-for="Currency">
            <option value="">Select Currency</option>
              
                    @foreach (var currency in ViewData["Currencies"] as List<Domain.Enum.CurrencyEnum>)
            {
                        <option value="@((int)currency)">@currency</option>
                    }
        </select>


                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="ExpireDate" class="control-label"></label>
                <input asp-for="ExpireDate" class="form-control" type="date" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />

                <span asp-validation-for="ExpireDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    // Function to generate a random 6-digit SKU and disable the input field
    document.getElementById('generateSku').addEventListener('click', function() {
        // Generate a random 6-digit number for SKU
        var randomSku = 'SKU'; // 6-digit random number
        var no = Math.floor(100000 + Math.random() * 900000);
        randomSku = no;
        // Set the value of the SKU input field
        document.getElementById('sk1').value = randomSku;
        document.getElementById('SKU').value = randomSku;

        // Disable the SKU input field after generating the number
        document.getElementById('sk1').disabled = true;

        // Optional: Disable the button after generating the SKU to prevent further clicks
        document.getElementById('generateSku').disabled = true;
    });
</script>
